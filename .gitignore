/target
**/*.rs.bk
*.swp
*.swo
.DS_Store
/.claude

# Byte-compiled live-test suite (`python3 -m py_compile testing/...`).
__pycache__/

# Built GNOME Shell extension bundle (gnome-extensions pack output).
# The source lives under extensions/beckon@xom11.github.io/.
extensions/*.shell-extension.zip

# Local git worktrees (isolated workspaces)
.worktrees/
.gstack/

# Per-plan scratch for subagent-driven execution: ledger, task briefs,
# implementer reports, review packages. Recovery state for a session in
# progress, never part of the history.
.superpowers/

# Private per-worktree build dir. CLAUDE.md requires one whenever you
# intend to RUN the binary and believe its output: `target/debug/beckon` is
# one path shared by every worktree, so the binary you run may be another
# branch's, and that failure reports nothing at all.
target-local/
