<!--
  beckon bindings for openbox / awesome / fluxbox-style minimal X11 WMs.

  Append this block inside the <keyboard>...</keyboard> section of
  ~/.config/openbox/rc.xml, then reload:

      openbox --reconfigure

  W- = Super (Mod4). C-A- = Ctrl+Alt. Pick whichever modifier is
  free in your existing config.

  Discover ids on your machine:
      beckon installed
      beckon list
      beckon resolve Spotify
-->

<keybind key="W-t">
  <action name="Execute"><command>beckon kitty</command></action>
</keybind>

<keybind key="W-c">
  <action name="Execute"><command>beckon "Google Chrome"</command></action>
</keybind>

<keybind key="W-v">
  <action name="Execute"><command>beckon "Visual Studio Code"</command></action>
</keybind>

<keybind key="W-f">
  <action name="Execute"><command>beckon Files</command></action>
</keybind>

<keybind key="W-s">
  <action name="Execute"><command>beckon Spotify</command></action>
</keybind>
