<?xml version="1.0" encoding="UTF-8"?>
<!--
  Scheduled Task definition for the beckon resident hotkey service.
  (XML comments cannot contain a double hyphen, so the flag itself is
  spelled out only in the Arguments element below.)

  Import with PowerShell (see the README — it substitutes the paths for
  you). Task Scheduler's own exports declare UTF-16; this file is UTF-8
  and declares UTF-8, which is what `Register-ScheduledTask -Xml` wants
  when you hand it a string. `schtasks /Create /XML` is pickier about
  encoding — prefer the PowerShell path.

  Replace every YOUR_USERNAME below with your Windows account name
  (echo %USERNAME%).

  Two things about this file are load-bearing:

  1. LogonType is InteractiveToken and there is no <RunOnlyIfIdle> — the
     task MUST run inside your interactive desktop session. Do not switch
     it to "run whether user is logged on or not": that lands the process
     in a non-interactive session where RegisterHotKey has no desktop to
     bind to, and no hotkey will ever fire.

  2. ExecutionTimeLimit is PT0S (unlimited). This is a daemon; the
     default 3-day limit would kill it.

  The <Command> below runs the exe directly, which is guaranteed to work
  but leaves a visible console window. Swap in the commented-out
  wscript action to hide it — see the README.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>beckon resident hotkey service</Description>
    <URI>\beckon-serve</URI>
  </RegistrationInfo>

  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>YOUR_USERNAME</UserId>
      <!-- Give the shell a moment to finish starting before grabbing keys. -->
      <Delay>PT15S</Delay>
    </LogonTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <UserId>YOUR_USERNAME</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>

  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\YOUR_USERNAME\.cargo\bin\beckon.exe</Command>
      <Arguments>--serve "C:\Users\YOUR_USERNAME\.config\beckon\apps.toml"</Arguments>
    </Exec>
    <!-- Hidden alternative — see beckon-serve.vbs:
    <Exec>
      <Command>wscript.exe</Command>
      <Arguments>"C:\Users\YOUR_USERNAME\.config\beckon\beckon-serve.vbs"</Arguments>
    </Exec>
    -->
  </Actions>
</Task>
