<?xml version="1.0" encoding="UTF-16"?>
<!--
  Scheduled Task definition for the beckon resident hotkey service.
  (XML comments cannot contain a double hyphen. The serve command has
  none, so it appears freely below; the log option still does, so it is
  spelled out only in the Arguments element.)

  The UTF-16 declaration above is REQUIRED and is not a typo: Task
  Scheduler rejects anything else with
      The task XML is malformed. (1,40)::ERROR: unable to switch the encoding
  even when the file itself is UTF-8, which this one is. Verified on
  Windows 11 ARM64 build 26200. Every task Windows exports declares
  UTF-16 for the same reason; Register-ScheduledTask reads the file into
  a .NET string (already UTF-16 in memory) before the service parses it,
  so the declaration matches by the time it matters.

  Import with PowerShell — see the README, which substitutes the paths
  for you.

  Replace every YOUR_USERNAME below with your Windows account name
  (echo %USERNAME%).

  Two things about this file are load-bearing:

  1. LogonType is InteractiveToken and there is no <RunOnlyIfIdle> — the
     task MUST run inside your interactive desktop session. Do not switch
     it to "run whether user is logged on or not": that lands the process
     in a non-interactive session where RegisterHotKey has no desktop to
     bind to, and no hotkey will ever fire.

  2. ExecutionTimeLimit is PT0S (unlimited). This is a daemon; the
     default 3-day limit would kill it.

  beckon writes its own log. The flag spelled out in Arguments below sends
  stderr to a file and detaches the console in one step, so this task runs
  beckon.exe directly: no cmd.exe for a redirect, and no wscript.exe shim
  to hide the window cmd.exe would have left behind. Task Scheduler
  discards a process's stderr, and stderr is where beckon reports how many
  hotkeys actually registered. Without the log there is no way to tell
  "20 registered" from "20 parsed, 0 registered".

  The log is APPENDED to, not truncated. The cmd.exe redirect this
  replaces truncated on every start, so RestartOnFailure destroyed the log
  explaining the failure it was restarting from.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>beckon resident hotkey service</Description>
    <URI>\beckon-serve</URI>
  </RegistrationInfo>

  <Triggers>
    <!-- No UserId here on purpose: the trigger already fires for whoever
         the Principal below names, and a UserId that Windows cannot map
         to an account fails registration outright. -->
    <LogonTrigger>
      <Enabled>true</Enabled>
      <!-- Give the shell a moment to finish starting before grabbing keys. -->
      <Delay>PT15S</Delay>
    </LogonTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <!-- A SID, not DOMAIN\user. On a machine that is not domain-joined
           USERDOMAIN is WORKGROUP, and "WORKGROUP\you" registers with
           "No mapping between account names and security IDs was done."
           The README's one-liner substitutes the current user's SID. -->
      <UserId>YOUR_USER_SID</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>

  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\YOUR_USERNAME\.cargo\bin\beckon.exe</Command>
      <Arguments>serve "C:\Users\YOUR_USERNAME\.config\beckon\apps.toml" --log "C:\Users\YOUR_USERNAME\AppData\Local\beckon\serve.log"</Arguments>
    </Exec>
  </Actions>
</Task>
