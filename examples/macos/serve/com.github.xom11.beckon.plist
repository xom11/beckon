<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github.xom11.beckon</string>

    <!-- launchd does NOT expand `~` or read your shell PATH: every path
         below must be absolute. The README has a sed one-liner that
         substitutes your real home directory.

         The log flag in the array is a DECLARATION, not a redirect. On
         macOS beckon writes nothing to that file: launchd does, through
         the two Standard*Path keys below, and a second writer on the same
         fd is how a log gets interleaved garbage. The flag is the only way
         beckon learns WHERE launchd put the file, and it has to know
         because the tray's "Open log" row and the settings window's System
         page log row are both OMITTED when no path was supplied. Drop it
         and launchd still captures stderr, to a file the tray cannot name.
         So: keep the path in the array and the two below identical. The
         Homebrew formula's `service do` block passes the same three.
         (This comment spells the flag out rather than writing it, because
         an XML comment may not contain a double hyphen.) -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/.cargo/bin/beckon</string>
        <string>serve</string>
        <string>/Users/YOUR_USERNAME/.config/beckon/apps.toml</string>
        <string>--log</string>
        <string>/tmp/beckon-serve.log</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if the process dies, but ONLY when it exited non-zero.
         A bare <true/> here restarts on any exit, including a clean one,
         which silently undoes beckon's own tray Quit: the menu item exits
         0 and launchd has the daemon back within the throttle window,
         forever, with no way to stop it short of `launchctl unload`.
         Note this still retries a startup failure (unreadable or missing
         config) on launchd's ~10 s throttle, so run `beckon check` before
         loading the agent. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- `serve` logs registrations, reloads and per-hotkey errors to
         stderr. This is the only place you can see them once launchd
         owns the process. Both keys and the path in ProgramArguments
         above name the same file; change one and change all three. -->
    <key>StandardOutPath</key>
    <string>/tmp/beckon-serve.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/beckon-serve.log</string>

    <!-- Keeps the process off the background-work scheduler tier so
         hotkey dispatch is not throttled. -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
