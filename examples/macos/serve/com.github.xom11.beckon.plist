<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github.xom11.beckon</string>

    <!-- launchd does NOT expand `~` or read your shell PATH: both paths
         below must be absolute. The README has a sed one-liner that
         substitutes your real home directory. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/.cargo/bin/beckon</string>
        <string>serve</string>
        <string>/Users/YOUR_USERNAME/.config/beckon/apps.toml</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if the process dies. Note this also retries a startup
         failure (unreadable or invalid config) on launchd's ~10 s
         throttle, so run `beckon check` before loading the agent. -->
    <key>KeepAlive</key>
    <true/>

    <!-- `serve` logs registrations, reloads and per-hotkey errors to
         stderr. This is the only place you can see them once launchd
         owns the process. -->
    <key>StandardOutPath</key>
    <string>/tmp/beckon-serve.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/beckon-serve.log</string>

    <!-- Keeps the process off the background-work scheduler tier so
         hotkey dispatch is not throttled. -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
